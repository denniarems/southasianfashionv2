{
	"name": "southasianfashion",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && tsc --noEmit",
		"preview": "vite preview",
		"deploy": "alchemy deploy",
		"deploy:wrangler": "bun run build && wrangler deploy",
		"destroy": "alchemy destroy",
		"cf:login": "alchemy login",
		"cf:configure": "alchemy configure",
		"cf-typegen": "wrangler types --env-file .dev.vars.example",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply southasianfashion-prod --local",
		"db:migrate:remote": "wrangler d1 migrations apply southasianfashion-prod --remote",
		"db:seed": "bun run db:seed:local",
		"db:seed:local": "wrangler d1 execute southasianfashion-prod --local --file=./scripts/seed-d1.sql",
		"db:seed:remote": "wrangler d1 execute southasianfashion-prod --remote --file=./scripts/seed-d1.sql",
		"type-check": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@openrouter/sdk": "^0.9.11",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@tanstack/react-router": "^1.169.2",
		"@tanstack/react-start": "^1.167.64",
		"@vitejs/plugin-react": "^6.0.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cookie": "^1.1.1",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.1",
		"framer-motion": "^12.34.3",
		"input-otp": "^1.4.2",
		"lenis": "^1.3.17",
		"lucide-react": "^0.575.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"resend": "^6.9.3",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss-animate": "^1.0.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.36.0",
		"@react-grab/mcp": "^0.1.23",
		"@tailwindcss/postcss": "^4",
		"@types/cookie": "^1.0.0",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"alchemy": "^0.93.7",
		"drizzle-kit": "^0.31.9",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"react-grab": "^0.1.23",
		"shadcn": "^3.8.5",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5",
		"vite": "^8.0.10",
		"wrangler": "^4.88.0"
	}
}
