{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "southasianfashion",
  "compatibility_date": "2026-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "SAF_DB",
      "database_name": "southasianfashion",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_MEDIA",
      "bucket_name": "southasianfashion-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "send_email": [
    {
      "name": "OTP_EMAIL",
      "allowed_destination_addresses": [
        "[email protected]"
      ],
      "allowed_sender_addresses": [
        "[email protected]"
      ]
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "[email protected]",
    "SENDER_EMAIL": "[email protected]",
    "R2_PUBLIC_URL": "https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev",
    "CLOUDFLARE_IMAGES_DELIVERY_HOST": "imagedelivery.net",
    "NEXT_PUBLIC_SITE_URL": "http://127.0.0.1:3000",
    "NODE_ENV": "production"
  }
}
