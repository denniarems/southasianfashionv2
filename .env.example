# Cloudflare runtime vars mirrored from wrangler.toml for local tooling.
SITE_URL="https://southasianfashion.ca"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"
ADMIN_EMAIL="admin@example.com"
SENDER_EMAIL="SouthAsianFashion <admin@example.com>"

# Cloudflare runtime secrets. Store production values with `wrangler secret put`.
OPENROUTER_API_KEY="replace-with-your-openrouter-api-key"
RESEND_API_KEY="replace-with-your-resend-api-key"
JWT_SECRET="replace-with-a-long-random-secret"

# Cloudflare account and API token for Alchemy, Wrangler deploys, and D1 seed/migration commands.
# The token must be able to edit Workers, Workers routes/custom domains, D1, R2, and DNS in the target zone.
CLOUDFLARE_ACCOUNT_ID="bc5dfa0d862d5a660638ac2b8d9ff70f"
CLOUDFLARE_API_TOKEN="replace-with-your-cloudflare-api-token"
CLOUDFLARE_DATABASE_ID="replace-with-your-cloudflare-d1-database-id"
CLOUDFLARE_D1_TOKEN="replace-with-your-cloudflare-d1-token"

# Alchemy deployment settings.
ALCHEMY_PASSWORD="replace-with-a-long-random-alchemy-state-password"
ALCHEMY_STAGE="prod"
ALCHEMY_SITE_DOMAIN="southasianfashion.ca"
ALCHEMY_WORKER_NAME="southasianfashion"
ALCHEMY_D1_DATABASE_NAME="southasianfashion-prod"
ALCHEMY_R2_BUCKET_NAME="southasianfashion-media"
ALCHEMY_R2_DOMAIN="media.southasianfashion.ca"

# Keep custom domains disabled until you are ready to move DNS from Vercel to Cloudflare Workers.
ALCHEMY_ENABLE_CUSTOM_DOMAINS="true"
ALCHEMY_WORKER_DOMAINS="southasianfashion.ca,www.southasianfashion.ca"
CLOUDFLARE_ZONE_ID="e0a82599263f1e0007e0bfe782feb9c8"
