{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"types": ["node", "vite/client"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"types/**/*.d.ts",
		"alchemy.run.ts",
		"drizzle.config.ts",
		"vite.config.ts",
		"worker-configuration.d.ts"
	],
	"exclude": ["node_modules", ".next", ".tanstack/tmp", "dist"]
}
