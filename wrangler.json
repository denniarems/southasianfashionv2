{
    "name": "southasianfashion",
    "main": "vinext/server/app-router-entry",
    "compatibility_date": "2024-09-23",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "saf-db",
            "database_id": "local-db"
        }
    ],
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "saf-bucket"
        }
    ]
}
